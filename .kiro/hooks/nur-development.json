{
  "version": "v1",
  "hooks": [
    {
      "name": "C Code Standards Check",
      "trigger": "PostFileSave",
      "matcher": "\\.(c|h)$",
      "action": {
        "type": "agent",
        "prompt": "Review this C code for nur.h standards compliance, memory safety, and C11/C23 compatibility. Check for: 1) Proper macro hygiene and parenthesization 2) Multi-standard compatibility 3) Memory safety patterns 4) Zero-allocation compliance 5) Error handling patterns following NurResult conventions"
      }
    },
    {
      "name": "Compile Check on Save",
      "trigger": "PostFileSave",
      "matcher": "nur\\.h$",
      "action": {
        "type": "command",
        "command": "gcc -std=c11 -Wall -Wextra -Wpedantic -fsyntax-only src/nur.h"
      }
    },
    {
      "name": "Multi-Standard Compatibility Check",
      "trigger": "PostFileSave", 
      "matcher": "nur\\.h$",
      "action": {
        "type": "command",
        "command": "gcc -std=c99 -Wall -Wextra -Wpedantic -fsyntax-only src/nur.h && gcc -std=c17 -Wall -Wextra -Wpedantic -fsyntax-only src/nur.h"
      }
    }
  ]
}