#!/usr/bin/env bash
# =============================================================================
# nur-cc - Universal Developer CLI & Compile Guard for nur.h
# Supports: Linux, macOS, WSL, Git Bash, MSYS2
# =============================================================================

set -e

# Default settings
LANG_MODE="en"
AUTO_FIX=0
LINT_ONLY=0
OUTPUT_BIN=""
SOURCE_FILE=""
EXTRA_ARGS=()

# Detect locale
if [[ "${LANG:-}" =~ ^bn ]] || [[ "${LC_ALL:-}" =~ ^bn ]]; then
    LANG_MODE="bn"
fi

# Print usage
show_help() {
    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;36mnur-cc (v1.2.1) — nur.h কম্পাইলার, লিন্টার ও প্রজেক্ট স্কাফোল্ডিং টুল\033[0m"
        echo ""
        echo -e "\033[1;33mব্যবহার:\033[0m"
        echo "  nur-cc [অপশন] <ফাইল.c>           C কোড লিন্ট ও কম্পাইল করা"
        echo "  nur-cc --lint <ফাইল.c>           শুধুমাত্র nur.h সেফটি ও AI রুলস পরীক্ষা করা"
        echo "  nur-cc --new <প্রজেক্ট_ডিরেক্টরি>   নতুন nur.h প্রজেক্ট তৈরি (৩-মিনিট কুইক স্টার্ট)"
        echo "  nur-cc --wrap \"<C সিগনেচার>\"      লেগ্যাসি ফাংশনকে NurResult-এ রূপান্তর রেসিপি তৈরি"
        echo "  nur-cc --examples                রেপো-র বাস্তবমুখী ১৭টি উদাহরণ তালিকা ও ডেমো কোড"
        echo ""
        echo -e "\033[1;33mঅপশনসমূহ:\033[0m"
        echo "  -o <আউটপুট>       কম্পাইল করা বাইনারির নাম নির্ধারণ"
        echo "  --fix             সেমিকোলন ও টাইপো স্বয়ংক্রিয়ভাবে ঠিক করা"
        echo "  --lang=en|bn      ভাষা নির্বাচন (ডিফল্ট: en / বাংলা অটো-ডিটেক্ট)"
        echo "  -h, --help        সাহায্য বার্তা প্রদর্শন"
    else
        echo -e "\033[1;36mnur-cc (v1.2.1) — nur.h Compiler, Linter & Project Scaffolding CLI\033[0m"
        echo ""
        echo -e "\033[1;33mUsage:\033[0m"
        echo "  nur-cc [options] <source.c>      Lint, build, and run C code"
        echo "  nur-cc --lint <source.c>         Static AI & safety rule audit only"
        echo "  nur-cc --new <project_dir>       Scaffold complete ready-to-build project"
        echo "  nur-cc --wrap \"<C signature>\"    Generate NurResult wrapper from legacy signature"
        echo "  nur-cc --examples                List real-world examples and snippets"
        echo ""
        echo -e "\033[1;33mOptions:\033[0m"
        echo "  -o <output>       Specify output binary name"
        echo "  --fix             Automatically fix missing semicolons and typos"
        echo "  --lang=en|bn      Language selection (default: en / Bengali locale auto-detected)"
        echo "  -h, --help        Show this help message"
    fi
    exit 0
}

scaffold_project() {
    local dir="$1"
    mkdir -p "$dir/src"

    cat << 'EOF' > "$dir/main.c"
/* Generated by nur-cc scaffold */
#include "src/nur.h"
#include <stdio.h>

NUR_NODISCARD NurResult_i32 divide(int a, int b) {
    if (b == 0) {
        return NUR_ERR(i32, NUR_ERROR(NUR_E_INVALID_ARGUMENT, "division by zero"));
    }
    return NUR_OK(i32, a / b);
}

int main(void) {
    printf("Welcome to your new nur.h project!\n");
    NurResult_i32 r = divide(10, 2);
    if (NUR_IS_OK(r)) {
        printf("10 / 2 = %d\n", NUR_VALUE(r));
    } else {
        nur_error_eprint(&NUR_ERROR_OF(r));
    }
    return 0;
}
EOF

    cat << 'EOF' > "$dir/Makefile"
CC ?= gcc
CFLAGS ?= -Wall -Wextra -Wpedantic -Werror -Isrc -O2

all:
	$(CC) $(CFLAGS) main.c -o app

run: all
	./app

clean:
	rm -f app app.exe
EOF

    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local repo_root="$(cd "$script_dir/.." && pwd)"
    if [ -f "$repo_root/src/nur.h" ]; then
        cp "$repo_root/src/nur.h" "$dir/src/nur.h"
    elif [ -f "src/nur.h" ]; then
        cp "src/nur.h" "$dir/src/nur.h"
    fi

    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;32m✓ প্রজেক্ট তৈরি সফল হয়েছে: '$dir'!\033[0m"
        echo "ফাইলসমূহ তৈরি করা হয়েছে:"
        echo "  - $dir/main.c"
        echo "  - $dir/Makefile"
        echo "  - $dir/src/nur.h"
        echo ""
        echo "রান করতে কমান্ড দিন:"
        echo "  cd $dir && make run"
    else
        echo -e "\033[1;32m✓ Project successfully scaffolded into '$dir'!\033[0m"
        echo "Created files:"
        echo "  - $dir/main.c"
        echo "  - $dir/Makefile"
        echo "  - $dir/src/nur.h"
        echo ""
        echo "To build and run:"
        echo "  cd $dir && make run"
    fi
    exit 0
}

generate_wrapper() {
    local sig="$1"
    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;36m🔄 সিগনেচার রূপান্তর রেসিপি:\033[0m $sig"
    else
        echo -e "\033[1;36m🔄 NurResult Migration Recipe for:\033[0m $sig"
    fi
    echo ""
    echo "/* 1. File-scope Result declaration (if not standard i32/usize/ptr) */"
    echo "NUR_RESULT_TYPE(int32_t, i32);"
    echo ""
    echo "/* 2. Safe NurResult wrapper function */"
    echo "NUR_NODISCARD NurResult_i32 your_func_safe(/* args */) {"
    echo "    int out_val = 0;"
    echo "    int rc = legacy_func(/* args */, &out_val);"
    echo "    if (rc != 0) {"
    echo "        return NUR_ERR(i32, NUR_ERROR_ERRNO(\"legacy_func call failed\"));"
    echo "    }"
    echo "    return NUR_OK(i32, out_val);"
    echo "}"
    exit 0
}

show_examples() {
    echo -e "\033[1;36mnur.h Production-Grade Examples Index:\033[0m"
    echo "  basic/01_hello_result.c          - Result creation, checking, fallback"
    echo "  basic/02_error_codes.c           - 36 error taxonomy categories"
    echo "  basic/03_option_types.c          - NurOption nullable values"
    echo "  basic/04_custom_types.c          - NUR_RESULT_TYPE with custom structs"
    echo "  basic/05_error_context.c         - File, func, line metadata"
    echo "  advanced/01_error_propagation.c  - Multi-tier call stack propagation"
    echo "  advanced/02_file_io.c            - errno capture & resource cleanup"
    echo "  advanced/03_allocation.c         - Zero-leak nur_malloc / nur_realloc"
    echo "  advanced/04_parsing.c            - Zero-allocation CSV parsing"
    echo "  real-world/01_config_parser.c    - Robust INI configuration parser"
    echo "  real-world/02_string_processing.c- Safe string manipulation pipeline"
    echo "  real-world/03_cli_arg_parser.c   - CLI option parser with port validation"
    echo "  real-world/04_json_parser.c      - Streaming JSON tokenizer & parser"
    echo "  real-world/05_socket_server.c    - Cross-platform TCP socket server"
    echo "  real-world/06_http_client.c      - HTTP wire serializer & response parser"
    echo "  real-world/07_thread_safe_logging.c - RFC 8259 JSON structured logging"
    echo "  real-world/08_embedded_sensor.c  - Microcontroller sensor driver with CRC-8"
    exit 0
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --lang=*)
            LANG_MODE="${1#*=}"
            shift
            ;;
        --fix)
            AUTO_FIX=1
            shift
            ;;
        --lint)
            LINT_ONLY=1
            shift
            ;;
        --new|--scaffold)
            scaffold_project "$2"
            ;;
        --wrap)
            generate_wrapper "$2"
            ;;
        --examples)
            show_examples
            ;;
        -o)
            OUTPUT_BIN="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            ;;
        *.c)
            SOURCE_FILE="$1"
            shift
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ -z "$SOURCE_FILE" ]; then
    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;31mত্রুটি: কোনো C সোর্স ফাইল উল্লেখ করা হয়নি!\033[0m"
        echo "ব্যবহার: ./nur-cc <ফাইল.c>"
    else
        echo -e "\033[1;31mError: No C source file specified!\033[0m"
        echo "Usage: ./nur-cc <source.c>"
    fi
    exit 1
fi

if [ ! -f "$SOURCE_FILE" ]; then
    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;31mত্রুটি: '$SOURCE_FILE' ফাইলটি খুঁজে পাওয়া যায়নি!\033[0m"
    else
        echo -e "\033[1;31mError: File '$SOURCE_FILE' not found!\033[0m"
    fi
    exit 1
fi

# Locate include directory for nur.h
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

INC_DIR="$REPO_ROOT/src"
if [ ! -d "$INC_DIR" ]; then
    INC_DIR="$REPO_ROOT"
fi

# Detect C Compiler
CC_CMD="${CC:-gcc}"
if ! command -v "$CC_CMD" &>/dev/null; then
    if command -v clang &>/dev/null; then
        CC_CMD="clang"
    fi
fi

# Set default output binary
if [ -z "$OUTPUT_BIN" ]; then
    BASENAME="$(basename "$SOURCE_FILE" .c)"
    if [[ "$OSTYPE" == "msys"* ]] || [[ "$OSTYPE" == "cygwin"* ]] || [[ "$OSTYPE" == "win32"* ]]; then
        OUTPUT_BIN="${BASENAME}.exe"
    else
        OUTPUT_BIN="./${BASENAME}"
    fi
fi

# Pre-flight syntax, typo, and heuristic safety scan
ERRORS_FOUND=0
LINE_NUM=0
LAST_WAS_OK_CHECK=0

while IFS= read -r raw_line || [ -n "$raw_line" ]; do
    LINE_NUM=$((LINE_NUM + 1))
    # Strip line comment for heuristics
    line="${raw_line%%//*}"

    # Check for banned gets()
    if [[ "$line" =~ [[:space:]]*gets[[:space:]]*\( ]]; then
        ERRORS_FOUND=$((ERRORS_FOUND + 1))
        if [ "$LANG_MODE" = "bn" ]; then
            echo -e "\033[1;31m🛑 [nur.h Shield] লাইন $LINE_NUM: অনিরাপদ 'gets()' ফাংশন পাওয়া গেছে!\033[0m"
            echo -e "\033[1;33m💡 সমাধান: বাফার ওভারফ্লো এড়াতে 'fgets()' ব্যবহার করুন।\033[0m"
        else
            echo -e "\033[1;31m🛑 [nur.h Shield] Line $LINE_NUM: Inherently unsafe 'gets()' detected!\033[0m"
            echo -e "\033[1;33m💡 Fix: Replace 'gets()' with safe 'fgets()'.\033[0m"
        fi
    fi

    # Check for prinf typo
    if [[ "$line" =~ prinf[[:space:]]*\( ]]; then
        ERRORS_FOUND=$((ERRORS_FOUND + 1))
        if [ "$LANG_MODE" = "bn" ]; then
            echo -e "\033[1;31m🛑 [nur.h Typo Guard] লাইন $LINE_NUM: টাইপো ধরা পড়েছে ('prinf')!\033[0m"
            echo -e "\033[1;33m💡 সমাধান: সঠিক বানান হবে 'printf'। ঠিক করতে চালান: ./nur-cc --fix $SOURCE_FILE\033[0m"
        else
            echo -e "\033[1;31m🛑 [nur.h Typo Guard] Line $LINE_NUM: Typo detected ('prinf')!\033[0m"
            echo -e "\033[1;33m💡 Fix: Did you mean 'printf'? Auto-fix with: ./nur-cc --fix $SOURCE_FILE\033[0m"
        fi
    fi

    # Check for missing semicolon on return
    if [[ "$line" =~ ^[[:space:]]*return[[:space:]]+[^;{]+$ ]] && [[ ! "$line" =~ \;[[:space:]]*$ ]]; then
        ERRORS_FOUND=$((ERRORS_FOUND + 1))
        if [ "$LANG_MODE" = "bn" ]; then
            echo -e "\033[1;31m🛑 [nur.h Shield] লাইন $LINE_NUM: 'return'-এর শেষে সেমিকোলন (;) নেই!\033[0m"
            echo -e "\033[1;33m💡 সমাধান: লাইনের শেষে ';' যোগ করুন অথবা চালান: ./nur-cc --fix $SOURCE_FILE\033[0m"
        else
            echo -e "\033[1;31m🛑 [nur.h Shield] Line $LINE_NUM: Missing semicolon ';' after return statement!\033[0m"
            echo -e "\033[1;33m💡 Fix: Add ';' at end of line or run: ./nur-cc --fix $SOURCE_FILE\033[0m"
        fi
    fi

    # Heuristic NUR_IS_OK before NUR_VALUE check
    if [[ "$line" =~ NUR_IS_OK || "$line" =~ nur_is_ok || "$line" =~ NUR_IS_ERR || "$line" =~ nur_is_err ]]; then
        LAST_WAS_OK_CHECK=1
    elif [[ "$line" =~ NUR_VALUE\( || "$line" =~ nur_value_ ]]; then
        if [ $LAST_WAS_OK_CHECK -eq 0 ] && [[ ! "$line" =~ NUR_UNWRAP ]] && [[ ! "$line" =~ if ]]; then
            if [ "$LANG_MODE" = "bn" ]; then
                echo -e "\033[1;33m⚠️  [nur.h AI Linter (হিউরিস্টিক)] লাইন $LINE_NUM: NUR_VALUE ডাকার আগে NUR_IS_OK চেক করা হয়েছে কি না নিশ্চিত করুন!\033[0m"
            else
                echo -e "\033[1;33m⚠️  [nur.h AI Linter (Heuristic)] Line $LINE_NUM: Ensure NUR_IS_OK is verified before calling NUR_VALUE!\033[0m"
            fi
        fi
    elif [[ "$line" =~ \} ]]; then
        LAST_WAS_OK_CHECK=0
    fi
done < "$SOURCE_FILE"

# Handle Auto-Fix
if [ $AUTO_FIX -eq 1 ]; then
    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;36m🔧 [nur.h Auto-Fix] কোড স্বয়ংক্রিয়ভাবে সংশোধন করা হচ্ছে...\033[0m"
    else
        echo -e "\033[1;36m🔧 [nur.h Auto-Fix] Applying automated syntax and formatting corrections...\033[0m"
    fi

    # Fix prinf typo
    sed -i 's/\bprinf(/printf(/g' "$SOURCE_FILE"

    # Fix missing semicolon on return
    sed -i -E 's/^([[:space:]]*return[[:space:]]+[^;{}]+)$/\1;/' "$SOURCE_FILE"

    # Format using clang-format if available
    if command -v clang-format &>/dev/null; then
        clang-format -i "$SOURCE_FILE"
    fi

    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;32m✓ [nur.h Auto-Fix] সংশোধন সম্পন্ন হয়েছে!\033[0m"
    else
        echo -e "\033[1;32m✓ [nur.h Auto-Fix] All automated fixes applied successfully!\033[0m"
    fi
    ERRORS_FOUND=0
fi

if [ $LINT_ONLY -eq 1 ]; then
    if [ $ERRORS_FOUND -eq 0 ]; then
        if [ "$LANG_MODE" = "bn" ]; then
            echo -e "\033[1;32m✓ [nur.h Linter] কোড সম্পূর্ণ নিরাপদ ও ত্রুটিমুক্ত পাওয়া গেছে।\033[0m"
        else
            echo -e "\033[1;32m✓ [nur.h Linter] Code verified 100% compliant with nur.h safety contract.\033[0m"
        fi
        exit 0
    else
        exit 1
    fi
fi

if [ $ERRORS_FOUND -gt 0 ]; then
    exit 1
fi

# Compile
if [ "$LANG_MODE" = "bn" ]; then
    echo -e "\033[1;34m🔨 কম্পাইল করা হচ্ছে: $SOURCE_FILE -> $OUTPUT_BIN ...\033[0m"
else
    echo -e "\033[1;34m🔨 Compiling: $SOURCE_FILE -> $OUTPUT_BIN ...\033[0m"
fi

"$CC_CMD" -Wall -Wextra -I"$INC_DIR" "$SOURCE_FILE" -o "$OUTPUT_BIN" "${EXTRA_ARGS[@]}"

# Run binary
if [ -f "$OUTPUT_BIN" ]; then
    if [ "$LANG_MODE" = "bn" ]; then
        echo -e "\033[1;32m🚀 প্রোগ্রাম চালানো হচ্ছে...\033[0m"
    else
        echo -e "\033[1;32m🚀 Executing program...\033[0m"
    fi
    "$OUTPUT_BIN"
fi
